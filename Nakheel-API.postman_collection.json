              ],
              "path": [
                "auth",
                "otp",
                "request"
              ]
            },
            "description": "أرقام تجريبية: مهندس 01000000000 - مزارع بمزرعة واحدة 01011122233 - مزارع بأكتر من مزرعة 01044455566"
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('role:', data.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01011122233\",\n  \"code\": \"1111\",\n  \"fcm_token\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "كود التفعيل ثابت 1111 دلوقتي. بيحفظ التوكن أوتوماتيك في collection variable 'token' عشان باقي الـ requests تستخدمه."
          }
        },
